# Local development. Copy to .env; never commit .env.
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Required for DEBUG=false. Generate a unique value; no default production secret.
SECRET_KEY=
# Empty uses SQLite locally. For production set MySQL and Redis.
DATABASE_URL=
REDIS_URL=
JUDGE_IMAGE=python:3.12-slim
# Docker Desktop cold starts can be slower than Linux servers.
JUDGE_CONTAINER_START_GRACE_SECONDS=10
# One container handles the complete submission; these are per-case and total execution budgets.
COURSEWORK_CASE_TIME_MS=2000
COURSEWORK_SUBMISSION_TIME_MS=30000
# 算法端大模型（默认口径）：端点、模型名与 Key 只放服务器环境，不下发到网页。
# 三项齐全才启用；缺项时所有智能体走规则兜底，并在结果里标注来源。
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=
# 是否允许数据库中的历史个人配置覆盖算法端配置；默认关闭。
# 页面已不提供个人模型配置入口，学生、教师和管理员都无需填写 Key。
# LLM_ALLOW_USER_OVERRIDE=false
# LLM_TIMEOUT=60
# 保留给历史个人配置写入逻辑的校验开关；页面入口已下线，正常部署无需修改。
# LLM_VERIFY_ON_SAVE=true
# LLM_VERIFY_TIMEOUT=20
# Knowledge-point score rate below this threshold counts as a weak point.
# PRACTICE_WEAK_THRESHOLD=0.6
# 8.1.4 口令与会话策略（默认值已满足三级等保，可按需收紧）。
# PASSWORD_MAX_AGE_DAYS=90
# PASSWORD_HISTORY_COUNT=5
# LOGIN_FAIL_LIMIT=5
# LOGIN_FAIL_WINDOW=600
# SESSION_COOKIE_AGE=1800
# SESSION_EXPIRE_AT_BROWSER_CLOSE=true
# INACTIVE_ACCOUNT_DAYS=90
# 字段级加密密钥：用于 API Key、口令恢复副本；留空由 SECRET_KEY 派生。
# 生产环境建议独立配置并纳入密钥管理，否则更换 SECRET_KEY 会导致历史密文不可解。
# FIELD_ENCRYPTION_KEY=
# 审计日志外发（JSON Lines，供日志平台集中收集）；留空只写数据库。
# AUDIT_LOG_FILE=.runtime/audit.jsonl
# 双因素：开启后未绑定动态口令的管理员/教师会被引导到绑定页。
# TOTP_ENFORCE=false
# TOTP_REQUIRED_ROLES=admin,security_admin,audit_admin,teacher
# 口令恢复副本默认关闭；确需开启时按字段级加密存储，仅管理员可查看并留痕。
# STORE_RECOVERY_PASSWORDS=0
# PRIVATE_STORAGE=.runtime/private
# JUDGE_HOST_STORAGE must point to the same directory on the Docker daemon host.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# HTTPS_REDIRECT=true
# TRUST_PROXY=true
# 日志级别会被 settings.py 读取（DEBUG 下默认 INFO，否则 WARNING），排查问题时可临时设为 DEBUG。
LOG_LEVEL=DEBUG
