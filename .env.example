# Local development. Copy to .env; never commit .env.
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Required for DEBUG=false. Generate a unique value; no default production secret.
SECRET_KEY=
# Empty uses SQLite locally. For production set MySQL and Redis.
DATABASE_URL=
REDIS_URL=
JUDGE_IMAGE=python:3.12-slim
# Docker Desktop cold starts can be slower than Linux servers.
JUDGE_CONTAINER_START_GRACE_SECONDS=10
# One container handles the complete submission; these are per-case and total execution budgets.
COURSEWORK_CASE_TIME_MS=2000
COURSEWORK_SUBMISSION_TIME_MS=30000
# Temporary local recovery requested for this version. Defaults to 1 only in DEBUG.
# STORE_RECOVERY_PASSWORDS=1
# PRIVATE_STORAGE=.runtime/private
# JUDGE_HOST_STORAGE must point to the same directory on the Docker daemon host.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# HTTPS_REDIRECT=true
# TRUST_PROXY=true
# 题目分析智能体（可选）：OpenAI 兼容端点。未配置时只能使用规则兜底，结果会标注来源。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=60
